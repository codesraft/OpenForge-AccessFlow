# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or a local instance)
DATABASE_URL=mongodb+srv://username:password@cluster0.example.mongodb.net/authacckit

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-long-random-secret-key-here
# Public URL of THIS server. Google redirects back to <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth (optional: the "Continue with Google" flow is off when these are empty)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Avatar uploads
IMGBB_API_KEY=your-imgbb-api-key

# Email. In development, leave SMTP_URL empty to print emails in the terminal instead.
EMAIL_FROM=no-reply@example.com
SMTP_URL=smtp://username:password@smtp.example.com:587

# Public URL of the Next.js client. This is the only origin allowed by CORS (plus TRUSTED_ORIGINS).
CLIENT_URL=http://localhost:3000
# Extra allowed origins, comma separated (for example a preview deployment). Optional.
TRUSTED_ORIGINS=

# Cookie SameSite: lax | strict | none. Defaults to lax in development and none in production.
# "none" is needed when the client and server are on different sites, and requires HTTPS.
COOKIE_SAME_SITE=
