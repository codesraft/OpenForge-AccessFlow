# Public URL of the Express server (or of this client itself when using the proxy below).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional. Only set this for same-origin mode: the Express server URL that /api/* is forwarded to.
# In that mode NEXT_PUBLIC_API_URL must be this client's own URL. See the server's DEPLOYMENT.md.
API_PROXY_TARGET=
